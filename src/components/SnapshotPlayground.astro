---
const serviceUrl = 'https://open-snapshot.muedsa.com';
const apiUrl = `${serviceUrl}/snapshot`;

const examples = [
  {
    id: 'welcome',
    label: '品牌卡片',
    source: `<Snapshot type="png" background="#FF020617">
  <Container
    width="720"
    height="420"
    padding="48"
    color="#FF0F172A"
    border="1 SOLID #FF334155"
    borderRadius="32">
    <Column crossAxisAlignment="START" mainAxisAlignment="CENTER">
      <Text color="#FF38BDF8" fontSize="18" fontStyle="BOLD">SNAPSHOT PLAYGROUND</Text>
      <Container height="18" />
      <Text color="#FFF8FAFC" fontSize="48" fontStyle="BOLD">声明式构建图片</Text>
      <Container height="14" />
      <Text color="#FF94A3B8" fontSize="24">Widget tree → Layout → Skia → Image</Text>
      <Container height="36" />
      <Container
        padding="(12,20)"
        color="#FF082F49"
        border="1 SOLID #FF0EA5E9"
        borderRadius="24">
        <Text color="#FFBAE6FD" fontSize="17">PNG · JPEG · WebP</Text>
      </Container>
    </Column>
  </Container>
</Snapshot>`,
  },
  {
    id: 'palette',
    label: '配色面板',
    source: `<Snapshot type="png" background="#FFF8FAFC">
  <Container width="720" height="360" padding="36" color="#FFF8FAFC">
    <Column crossAxisAlignment="START">
      <Text color="#FF0F172A" fontSize="32" fontStyle="BOLD">Color palette</Text>
      <Container height="10" />
      <Text color="#FF64748B" fontSize="18">用 Row 和 Container 组合简单版面</Text>
      <Container height="28" />
      <Row>
        <Container width="150" height="180" margin="8" color="#FF0EA5E9" borderRadius="24" />
        <Container width="150" height="180" margin="8" color="#FF8B5CF6" borderRadius="24" />
        <Container width="150" height="180" margin="8" color="#FFF43F5E" borderRadius="24" />
        <Container width="150" height="180" margin="8" color="#FF10B981" borderRadius="24" />
      </Row>
    </Column>
  </Container>
</Snapshot>`,
  },
  {
    id: 'poster',
    label: 'Stack 海报',
    source: `<Snapshot type="png" background="#FF111827">
  <Stack alignment="TOP_LEFT">
    <Container width="720" height="420" color="#FF111827" />
    <Positioned left="42" top="42">
      <Container width="110" height="110" color="#FF38BDF8" borderRadius="55" />
    </Positioned>
    <Positioned right="52" bottom="52">
      <Container width="180" height="180" color="#FF8B5CF6" borderRadius="90" />
    </Positioned>
    <Positioned left="56" top="154" right="56">
      <Column crossAxisAlignment="START">
        <Text color="#FFF8FAFC" fontSize="50" fontStyle="BOLD">Compose the pixels.</Text>
        <Container height="18" />
        <Text color="#FFCBD5E1" fontSize="22">结构化、可复用、可测试的服务端出图。</Text>
      </Column>
    </Positioned>
  </Stack>
</Snapshot>`,
  },
];
---

<section
  class="playground-shell"
  data-snapshot-playground
  data-api-url={apiUrl}
>
  <div class="playground-toolbar" aria-label="Playground 操作栏">
    <div class="example-picker">
      <label for="playground-example">示例</label>
      <select id="playground-example" data-example-select>
        {examples.map((example) => <option value={example.id}>{example.label}</option>)}
      </select>
    </div>

    <a class="endpoint" href={serviceUrl} target="_blank" rel="noreferrer" title="打开 Open Snapshot 服务">
      <span class="endpoint-dot" aria-hidden="true"></span>
      <span>open-snapshot.muedsa.com</span>
    </a>

    <div class="toolbar-actions">
      <button class="button button-quiet" type="button" data-copy>复制代码</button>
      <button class="button button-quiet" type="button" data-reset>重置</button>
      <button class="button button-primary" type="button" data-render>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="m8 5 11 7-11 7V5Z" fill="currentColor" /></svg>
        <span data-render-label>运行</span>
        <kbd>Ctrl ↵</kbd>
      </button>
    </div>
  </div>

  <div class="playground-grid">
    <section class="pane editor-pane" aria-labelledby="editor-title">
      <header class="pane-header">
        <div>
          <span class="eyebrow">INPUT</span>
          <h2 id="editor-title">Snapshot DSL</h2>
        </div>
        <span class="line-count" data-line-count>0 行</span>
      </header>
      <div class="editor-wrap">
        <textarea
          data-editor
          aria-label="Snapshot DSL 编辑器"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          wrap="off"
        >{examples[0].source}</textarea>
      </div>
    </section>

    <section class="pane preview-pane" aria-labelledby="preview-title">
      <header class="pane-header">
        <div>
          <span class="eyebrow">OUTPUT</span>
          <h2 id="preview-title">渲染结果</h2>
        </div>
        <div class="preview-actions">
          <span class="status status-idle" data-status>等待运行</span>
          <button class="icon-button" type="button" data-download disabled aria-label="下载渲染结果" title="下载图片">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
          </button>
        </div>
      </header>

      <div class="preview-stage" data-preview-stage>
        <div class="empty-state" data-empty-state>
          <div class="empty-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="32" height="32"><path d="M6 5h20a2 2 0 0 1 2 2v18a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="m7 23 6-7 4 4 3-3 5 6M22 12h.01" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"/></svg>
          </div>
          <strong>准备好生成第一张图片</strong>
          <span>编辑左侧 DSL，然后点击“运行”</span>
        </div>
        <div class="loading-state" data-loading-state hidden aria-live="polite">
          <span class="spinner" aria-hidden="true"></span>
          <span>服务端正在解析并渲染…</span>
        </div>
        <img data-preview-image hidden alt="Snapshot DSL 渲染结果" />
        <div class="error-state" data-error-state hidden role="alert">
          <span class="error-code" data-error-code>RENDER_ERROR</span>
          <strong data-error-title>渲染失败</strong>
          <p data-error-message></p>
          <span class="request-id" data-request-id></span>
        </div>
      </div>

      <footer class="result-meta" data-result-meta hidden>
        <span data-image-size></span>
        <span data-file-size></span>
        <span data-duration></span>
        <span data-cache></span>
      </footer>
    </section>
  </div>

  <p class="playground-note">
    请求会从浏览器直接发送到公开的 Open Snapshot 服务。匿名调用受频率限制，请避免连续快速运行；需要了解 DSL 时可查阅
    <a href="/reference/parser-tags/">标签与属性参考</a>。
  </p>
</section>

<script define:vars={{ examples }}>
  const root = document.querySelector('[data-snapshot-playground]');

  if (root instanceof HTMLElement) {
    const editor = root.querySelector('[data-editor]');
    const exampleSelect = root.querySelector('[data-example-select]');
    const renderButton = root.querySelector('[data-render]');
    const renderLabel = root.querySelector('[data-render-label]');
    const resetButton = root.querySelector('[data-reset]');
    const copyButton = root.querySelector('[data-copy]');
    const downloadButton = root.querySelector('[data-download]');
    const lineCount = root.querySelector('[data-line-count]');
    const status = root.querySelector('[data-status]');
    const emptyState = root.querySelector('[data-empty-state]');
    const loadingState = root.querySelector('[data-loading-state]');
    const previewImage = root.querySelector('[data-preview-image]');
    const errorState = root.querySelector('[data-error-state]');
    const errorCode = root.querySelector('[data-error-code]');
    const errorTitle = root.querySelector('[data-error-title]');
    const errorMessage = root.querySelector('[data-error-message]');
    const requestId = root.querySelector('[data-request-id]');
    const resultMeta = root.querySelector('[data-result-meta]');
    const imageSize = root.querySelector('[data-image-size]');
    const fileSize = root.querySelector('[data-file-size]');
    const duration = root.querySelector('[data-duration]');
    const cache = root.querySelector('[data-cache]');
    const apiUrl = root.dataset.apiUrl;
    const storageKey = 'snapshot-playground-source';

    let imageUrl = '';
    let imageBlob;
    let controller;

    const setHidden = (element, hidden) => {
      if (element instanceof HTMLElement) element.hidden = hidden;
    };

    const setStatus = (label, kind) => {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = label;
      status.className = `status status-${kind}`;
    };

    const updateLineCount = () => {
      if (!(editor instanceof HTMLTextAreaElement) || !(lineCount instanceof HTMLElement)) return;
      const count = editor.value.split('\n').length;
      lineCount.textContent = `${count} 行`;
    };

    const formatBytes = (bytes) => {
      if (bytes < 1024) return `${bytes} B`;
      return `${(bytes / 1024).toFixed(bytes < 10240 ? 1 : 0)} KB`;
    };

    const clearImage = () => {
      if (imageUrl) URL.revokeObjectURL(imageUrl);
      imageUrl = '';
      imageBlob = undefined;
      if (previewImage instanceof HTMLImageElement) {
        previewImage.removeAttribute('src');
        previewImage.hidden = true;
      }
      if (downloadButton instanceof HTMLButtonElement) downloadButton.disabled = true;
    };

    const showError = (payload, fallbackMessage) => {
      clearImage();
      setHidden(emptyState, true);
      setHidden(loadingState, true);
      setHidden(errorState, false);
      setHidden(resultMeta, true);
      if (errorCode instanceof HTMLElement) errorCode.textContent = payload?.code || 'REQUEST_FAILED';
      if (errorTitle instanceof HTMLElement) errorTitle.textContent = '渲染失败';
      if (errorMessage instanceof HTMLElement) errorMessage.textContent = payload?.message || fallbackMessage;
      if (requestId instanceof HTMLElement) {
        requestId.textContent = payload?.requestId ? `Request ID: ${payload.requestId}` : '';
      }
      setStatus('运行失败', 'error');
    };

    const render = async () => {
      if (!(editor instanceof HTMLTextAreaElement) || !apiUrl || !editor.value.trim()) return;
      controller?.abort();
      controller = new AbortController();

      if (renderButton instanceof HTMLButtonElement) renderButton.disabled = true;
      if (renderLabel instanceof HTMLElement) renderLabel.textContent = '运行中';
      setStatus('正在渲染', 'loading');
      setHidden(emptyState, true);
      setHidden(errorState, true);
      setHidden(previewImage, true);
      setHidden(resultMeta, true);
      setHidden(loadingState, false);

      try {
        const startedAt = performance.now();
        const requestOptions = {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain; charset=utf-8', Accept: 'image/*, application/json' },
          body: editor.value,
          mode: 'cors',
          credentials: 'omit',
          signal: controller.signal,
        };
        const response = await fetch(apiUrl, requestOptions);
        const elapsed = performance.now() - startedAt;
        const contentType = response.headers.get('content-type') || '';

        if (!response.ok || !contentType.startsWith('image/')) {
          let payload;
          try {
            payload = await response.json();
          } catch {
            payload = undefined;
          }
          showError(payload, `服务返回 ${response.status} ${response.statusText || ''}`.trim());
          return;
        }

        const blob = await response.blob();
        clearImage();
        imageBlob = blob;
        imageUrl = URL.createObjectURL(blob);

        if (previewImage instanceof HTMLImageElement) {
          previewImage.src = imageUrl;
          await previewImage.decode();
          previewImage.hidden = false;
          if (imageSize instanceof HTMLElement) {
            imageSize.textContent = `${previewImage.naturalWidth} × ${previewImage.naturalHeight}`;
          }
        }

        if (fileSize instanceof HTMLElement) fileSize.textContent = formatBytes(blob.size);
        if (duration instanceof HTMLElement) duration.textContent = `${Math.round(elapsed)} ms`;
        if (cache instanceof HTMLElement) {
          const cacheValue = response.headers.get('x-snapshot-cache');
          cache.textContent = cacheValue === 'hit' ? '缓存命中' : cacheValue === 'miss' ? '实时渲染' : '';
          cache.hidden = !cacheValue;
        }

        setHidden(loadingState, true);
        setHidden(errorState, true);
        setHidden(resultMeta, false);
        if (downloadButton instanceof HTMLButtonElement) downloadButton.disabled = false;
        setStatus('渲染完成', 'success');
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        const message = error instanceof Error && error.message !== 'Failed to fetch'
          ? error.message
          : '无法连接 Open Snapshot 服务，请稍后重试。';
        showError(undefined, message);
      } finally {
        if (renderButton instanceof HTMLButtonElement) renderButton.disabled = false;
        if (renderLabel instanceof HTMLElement) renderLabel.textContent = '运行';
      }
    };

    if (editor instanceof HTMLTextAreaElement) {
      const saved = localStorage.getItem(storageKey);
      if (saved) editor.value = saved;
      updateLineCount();

      editor.addEventListener('input', () => {
        localStorage.setItem(storageKey, editor.value);
        updateLineCount();
      });

      editor.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key === 'Enter') {
          event.preventDefault();
          render();
          return;
        }
        if (event.key === 'Tab') {
          event.preventDefault();
          const start = editor.selectionStart;
          const end = editor.selectionEnd;
          editor.setRangeText('  ', start, end, 'end');
          editor.dispatchEvent(new Event('input'));
        }
      });
    }

    exampleSelect?.addEventListener('change', () => {
      if (!(exampleSelect instanceof HTMLSelectElement) || !(editor instanceof HTMLTextAreaElement)) return;
      const example = examples.find((item) => item.id === exampleSelect.value);
      if (!example) return;
      editor.value = example.source;
      localStorage.setItem(storageKey, editor.value);
      updateLineCount();
      setStatus('等待运行', 'idle');
      clearImage();
      setHidden(errorState, true);
      setHidden(resultMeta, true);
      setHidden(emptyState, false);
    });

    renderButton?.addEventListener('click', render);

    resetButton?.addEventListener('click', () => {
      if (!(editor instanceof HTMLTextAreaElement) || !(exampleSelect instanceof HTMLSelectElement)) return;
      const selected = examples.find((item) => item.id === exampleSelect.value) || examples[0];
      editor.value = selected.source;
      localStorage.removeItem(storageKey);
      updateLineCount();
      setStatus('已重置', 'idle');
      clearImage();
      setHidden(loadingState, true);
      setHidden(errorState, true);
      setHidden(resultMeta, true);
      setHidden(emptyState, false);
    });

    copyButton?.addEventListener('click', async () => {
      if (!(editor instanceof HTMLTextAreaElement) || !(copyButton instanceof HTMLButtonElement)) return;
      await navigator.clipboard.writeText(editor.value);
      const original = copyButton.textContent;
      copyButton.textContent = '已复制';
      window.setTimeout(() => { copyButton.textContent = original; }, 1200);
    });

    downloadButton?.addEventListener('click', () => {
      if (!imageBlob || !imageUrl) return;
      const extension = imageBlob.type === 'image/jpeg' ? 'jpg' : imageBlob.type.split('/')[1] || 'png';
      const anchor = document.createElement('a');
      anchor.href = imageUrl;
      anchor.download = `snapshot-${Date.now()}.${extension}`;
      anchor.click();
    });

    window.addEventListener('pagehide', clearImage, { once: true });
  }
</script>

<style>
  .playground-shell {
    --pg-border: color-mix(in srgb, var(--sl-color-gray-5) 72%, transparent);
    --pg-surface: color-mix(in srgb, var(--sl-color-gray-6) 76%, var(--sl-color-black));
    --pg-surface-raised: color-mix(in srgb, var(--sl-color-gray-6) 58%, var(--sl-color-black));
    margin-top: -0.5rem;
  }

  .playground-toolbar,
  .pane,
  .playground-note {
    border: 1px solid var(--pg-border);
  }

  .playground-toolbar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 3.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.9rem 0.9rem 0 0;
    background: var(--pg-surface-raised);
  }

  .example-picker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .example-picker label {
    color: var(--sl-color-gray-2);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .example-picker select {
    width: auto;
    min-width: 7rem;
    height: 2.35rem;
    border: 1px solid var(--pg-border);
    border-radius: 0.55rem;
    padding: 0 2rem 0 0.7rem;
    color: var(--sl-color-white);
    background-color: var(--sl-color-black);
    font: inherit;
    font-size: 0.88rem;
  }

  .endpoint {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.45rem;
    margin-right: auto;
    color: var(--sl-color-gray-2);
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .endpoint span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .endpoint-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0.2rem rgb(34 197 94 / 14%);
  }

  .toolbar-actions,
  .preview-actions {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .button,
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    color: inherit;
    font: inherit;
    font-weight: 650;
    cursor: pointer;
    transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;
  }

  .button {
    min-height: 2.35rem;
    gap: 0.4rem;
    border-radius: 0.55rem;
    padding: 0 0.8rem;
    font-size: 0.84rem;
  }

  .button:hover:not(:disabled),
  .icon-button:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .button-quiet {
    border-color: var(--pg-border);
    background: var(--sl-color-black);
  }

  .button-quiet:hover {
    border-color: var(--sl-color-gray-3);
    background: var(--sl-color-gray-6);
  }

  .button-primary {
    color: #fff;
    background: #0284c7;
    box-shadow: 0 0.4rem 1.2rem rgb(2 132 199 / 20%);
  }

  .button-primary:hover:not(:disabled) { background: #0369a1; }
  .button:disabled { cursor: wait; opacity: 0.65; }

  .button kbd {
    border: 0;
    border-left: 1px solid rgb(255 255 255 / 24%);
    border-radius: 0;
    margin-left: 0.15rem;
    padding: 0 0 0 0.45rem;
    color: rgb(255 255 255 / 68%);
    background: transparent;
    font-family: inherit;
    font-size: 0.68rem;
  }

  .playground-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 35rem;
  }

  .pane {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border-top: 0;
    background: var(--pg-surface);
  }

  .editor-pane { border-right: 0; }
  .preview-pane { border-radius: 0 0 0.9rem 0; }
  .editor-pane { border-radius: 0 0 0 0.9rem; }

  .pane-header {
    display: flex;
    min-height: 4.2rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--pg-border);
    padding: 0.75rem 1rem;
    background: var(--pg-surface-raised);
  }

  .pane-header h2 {
    margin: 0.08rem 0 0;
    color: var(--sl-color-white);
    font-size: 0.94rem;
    font-weight: 650;
  }

  .eyebrow {
    color: var(--sl-color-gray-3);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .line-count {
    color: var(--sl-color-gray-3);
    font-family: var(--__sl-font-mono);
    font-size: 0.72rem;
  }

  .editor-wrap {
    display: flex;
    flex: 1;
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--sl-color-gray-6) 76%, transparent) 3.2rem, transparent 3.2rem),
      var(--sl-color-black);
  }

  textarea {
    width: 100%;
    min-height: 30rem;
    resize: none;
    border: 0;
    outline: 0;
    padding: 1.15rem 1.2rem;
    color: var(--sl-color-gray-1);
    caret-color: #38bdf8;
    background: transparent;
    font-family: var(--__sl-font-mono);
    font-size: 0.79rem;
    line-height: 1.7;
    tab-size: 2;
  }

  textarea::selection { color: #fff; background: rgb(14 165 233 / 38%); }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    padding: 0.3rem 0.58rem;
    font-size: 0.69rem;
    font-weight: 700;
  }

  .status::before {
    content: '';
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: currentColor;
  }

  .status-idle { color: var(--sl-color-gray-2); background: var(--sl-color-gray-6); }
  .status-loading { color: #7dd3fc; background: rgb(14 165 233 / 13%); }
  .status-success { color: #86efac; background: rgb(34 197 94 / 13%); }
  .status-error { color: #fda4af; background: rgb(244 63 94 / 13%); }

  .icon-button {
    width: 2.25rem;
    height: 2.25rem;
    border-color: var(--pg-border);
    border-radius: 0.55rem;
    background: var(--sl-color-black);
  }

  .icon-button:disabled { cursor: not-allowed; opacity: 0.38; }

  .preview-stage {
    position: relative;
    display: grid;
    min-height: 30rem;
    flex: 1;
    place-items: center;
    overflow: auto;
    padding: 1.5rem;
    background-color: var(--sl-color-gray-6);
    background-image:
      linear-gradient(45deg, rgb(148 163 184 / 7%) 25%, transparent 25%),
      linear-gradient(-45deg, rgb(148 163 184 / 7%) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, rgb(148 163 184 / 7%) 75%),
      linear-gradient(-45deg, transparent 75%, rgb(148 163 184 / 7%) 75%);
    background-position: 0 0, 0 0.6rem, 0.6rem -0.6rem, -0.6rem 0;
    background-size: 1.2rem 1.2rem;
  }

  .preview-stage img {
    display: block;
    max-width: 100%;
    max-height: 30rem;
    border-radius: 0.35rem;
    box-shadow: 0 1.5rem 4rem rgb(2 6 23 / 35%);
    object-fit: contain;
  }

  .preview-stage [hidden],
  .result-meta[hidden] { display: none !important; }

  .empty-state,
  .loading-state,
  .error-state {
