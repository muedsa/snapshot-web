---
const serviceUrl = 'https://open-snapshot.muedsa.com';
const apiUrl = `${serviceUrl}/snapshot`;

const examples = [
  {
    id: 'welcome',
    label: '品牌卡片',
    source: `<Snapshot type="png" background="#FF020617">
  <Container
    width="720"
    height="420"
    padding="48"
    color="#FF0F172A"
    border="1 SOLID #FF334155"
    borderRadius="32">
    <Column crossAxisAlignment="START" mainAxisAlignment="CENTER">
      <Text color="#FF38BDF8" fontSize="18" fontStyle="BOLD">SNAPSHOT PLAYGROUND</Text>
      <Container height="18" />
      <Text color="#FFF8FAFC" fontSize="48" fontStyle="BOLD">声明式构建图片</Text>
      <Container height="14" />
      <Text color="#FF94A3B8" fontSize="24">Widget tree → Layout → Skia → Image</Text>
      <Container height="36" />
      <Container
        padding="(12,20)"
        color="#FF082F49"
        border="1 SOLID #FF0EA5E9"
        borderRadius="24">
        <Text color="#FFBAE6FD" fontSize="17">PNG · JPEG · WebP</Text>
      </Container>
    </Column>
  </Container>
</Snapshot>`,
  },
  {
    id: 'palette',
    label: '配色面板',
    source: `<Snapshot type="png" background="#FFF8FAFC">
  <Container width="720" height="360" padding="36" color="#FFF8FAFC">
    <Column crossAxisAlignment="START">
      <Text color="#FF0F172A" fontSize="32" fontStyle="BOLD">Color palette</Text>
      <Container height="10" />
      <Text color="#FF64748B" fontSize="18">用 Row 和 Container 组合简单版面</Text>
      <Container height="28" />
      <Row>
        <Container width="150" height="180" margin="8" color="#FF0EA5E9" borderRadius="24" />
        <Container width="150" height="180" margin="8" color="#FF8B5CF6" borderRadius="24" />
        <Container width="150" height="180" margin="8" color="#FFF43F5E" borderRadius="24" />
        <Container width="150" height="180" margin="8" color="#FF10B981" borderRadius="24" />
      </Row>
    </Column>
  </Container>
</Snapshot>`,
  },
  {
    id: 'poster',
    label: 'Stack 海报',
    source: `<Snapshot type="png" background="#FF111827">
  <Stack alignment="TOP_LEFT">
    <Container width="720" height="420" color="#FF111827" />
    <Positioned left="42" top="42">
      <Container width="110" height="110" color="#FF38BDF8" borderRadius="55" />
    </Positioned>
    <Positioned right="52" bottom="52">
      <Container width="180" height="180" color="#FF8B5CF6" borderRadius="90" />
    </Positioned>
    <Positioned left="56" top="154" right="56">
      <Column crossAxisAlignment="START">
        <Text color="#FFF8FAFC" fontSize="50" fontStyle="BOLD">Compose the pixels.</Text>
        <Container height="18" />
        <Text color="#FFCBD5E1" fontSize="22">结构化、可复用、可测试的服务端出图。</Text>
      </Column>
    </Positioned>
  </Stack>
</Snapshot>`,
  },
];

// 转义 "<" 以免 DSL 中的标签序列提前结束 script 标签。
const examplesJson = JSON.stringify(examples).replace(/</g, '\\u003c');
---

<section
  class="playground-shell not-content"
  data-snapshot-playground
  data-api-url={apiUrl}
>
  <script is:inline type="application/json" data-examples set:html={examplesJson} />

  <div class="playground-toolbar" aria-label="Playground 操作栏">
    <div class="example-picker">
      <label for="playground-example">示例</label>
      <select id="playground-example" data-example-select>
        {examples.map((example) => <option value={example.id}>{example.label}</option>)}
      </select>
    </div>

    <a class="endpoint" href={serviceUrl} target="_blank" rel="noreferrer" title="打开 Open Snapshot 服务">
      <span class="endpoint-dot" aria-hidden="true"></span>
      <span>open-snapshot.muedsa.com</span>
    </a>

    <div class="toolbar-actions">
      <button class="button button-quiet" type="button" data-copy>复制代码</button>
      <button class="button button-quiet" type="button" data-reset>重置</button>
      <button class="button button-primary" type="button" data-render>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="m8 5 11 7-11 7V5Z" fill="currentColor" /></svg>
        <span data-render-label>运行</span>
        <kbd>Ctrl ↵</kbd>
      </button>
    </div>
  </div>

  <div class="playground-grid">
    <section class="pane editor-pane" aria-labelledby="editor-title">
      <header class="pane-header">
        <div>
          <span class="eyebrow">INPUT</span>
          <h2 id="editor-title">Snapshot DSL</h2>
        </div>
        <div class="editor-meta">
          <span class="lsp-status" data-lsp-status data-state="connecting">语言服务连接中</span>
          <span class="problems" data-problems hidden></span>
          <span class="line-count" data-line-count>0 行</span>
        </div>
      </header>
      <div class="editor-wrap">
        <div class="editor-host" data-editor></div>
        <div class="editor-placeholder" data-editor-placeholder>
          <span class="spinner" aria-hidden="true"></span>
          <span>正在加载编辑器与语言服务…</span>
        </div>
      </div>
    </section>

    <section class="pane preview-pane" aria-labelledby="preview-title">
      <header class="pane-header">
        <div>
          <span class="eyebrow">OUTPUT</span>
          <h2 id="preview-title">渲染结果</h2>
        </div>
        <div class="preview-actions">
          <span class="status status-idle" data-status>等待运行</span>
          <button class="icon-button" type="button" data-download disabled aria-label="下载渲染结果" title="下载图片">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="19" height="19"><path d="M12 3v12m0 0 5-5m-5 5-5-5M5 20h14" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" /></svg>
          </button>
        </div>
      </header>

      <div class="preview-stage" data-preview-stage>
        <div class="empty-state" data-empty-state>
          <div class="empty-icon" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="32" height="32"><path d="M6 5h20a2 2 0 0 1 2 2v18a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2Z" fill="none" stroke="currentColor" stroke-width="2"/><path d="m7 23 6-7 4 4 3-3 5 6M22 12h.01" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"/></svg>
          </div>
          <strong>准备好生成第一张图片</strong>
          <span>编辑左侧 DSL，然后点击“运行”</span>
        </div>
        <div class="loading-state" data-loading-state hidden aria-live="polite">
          <span class="spinner" aria-hidden="true"></span>
          <span>服务端正在解析并渲染…</span>
        </div>
        <img data-preview-image hidden alt="Snapshot DSL 渲染结果" />
        <div class="error-state" data-error-state hidden role="alert">
          <span class="error-code" data-error-code>RENDER_ERROR</span>
          <strong data-error-title>渲染失败</strong>
          <p data-error-message></p>
          <span class="request-id" data-request-id></span>
        </div>
      </div>

      <footer class="result-meta" data-result-meta hidden>
        <span data-image-size></span>
        <span data-file-size></span>
        <span data-render-duration title="服务端解析、布局、光栅化和编码耗时"></span>
        <span data-server-duration title="服务端处理总耗时，包含排队和渲染"></span>
        <span data-queue-duration title="等待服务端渲染槽位的耗时"></span>
        <span data-image-duration title="远程图片获取耗时，已计入渲染耗时"></span>
        <span data-request-duration title="浏览器发起请求到响应体下载完毕的耗时"></span>
        <span data-image-count title="本次请求实际发起的远程图片下载次数"></span>
        <span data-cache></span>
      </footer>
    </section>
  </div>

  <p class="playground-note">
    Monaco 编辑器通过
    <a href="https://github.com/muedsa/snapshot-lsp" target="_blank" rel="noreferrer">snapshot-lsp</a>
    在浏览器内提供标签/属性补全、悬停说明与实时诊断；点击“运行”后，DSL 会从浏览器直接发送到公开的 Open Snapshot 服务。
    匿名调用受频率限制，请避免连续快速运行；需要了解 DSL 时可查阅
    <a href="/reference/parser-tags/">标签与属性参考</a>。
  </p>
</section>

<script>
  const root = document.querySelector('[data-snapshot-playground]');

  if (root instanceof HTMLElement) {
    // Monaco 与 snapshot-lsp worker 体积较大，按需懒加载，避免影响首屏。
    import('../playground/playground').then(
      ({ startPlayground }) => startPlayground(root),
      (error: unknown) => {
        console.error('[snapshot-playground] 编辑器加载失败', error);
        root.dataset.editorFailed = '';
        const placeholder = root.querySelector('[data-editor-placeholder]');
        if (placeholder instanceof HTMLElement) {
          placeholder.textContent = '编辑器加载失败，请刷新页面重试。';
        }
      },
    );
  }
</script>

<style>
  .playground-shell {
    --pg-border: color-mix(in srgb, var(--sl-color-gray-5) 72%, transparent);
    --pg-surface: color-mix(in srgb, var(--sl-color-gray-6) 76%, var(--sl-color-black));
    --pg-surface-raised: color-mix(in srgb, var(--sl-color-gray-6) 58%, var(--sl-color-black));
    margin-top: -0.5rem;
  }

  /*
    根节点带 not-content（见上面的 class），用于退出 Starlight 正文样式。
    Starlight 会给正文里相邻的块级元素加 margin-top，而 Monaco 的行、行号、边栏
    也是相邻 div，一旦被加上 margin，光标与字符的坐标就会错位。
  */

  .playground-toolbar,
  .pane,
  .playground-note {
    border: 1px solid var(--pg-border);
  }

  /* 隔离 Starlight 正文区为相邻元素添加的垂直间距，避免工具栏和面板错位。 */
  .playground-toolbar > *,
  .example-picker > *,
  .toolbar-actions > *,
  .playground-grid,
  .playground-grid > *,
  .pane > *,
  .pane-header > *,
  .editor-meta > *,
  .preview-actions > * {
    margin-block: 0;
  }

  .playground-toolbar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 3.75rem;
    padding: 0.65rem 0.75rem;
    border-radius: 0.9rem 0.9rem 0 0;
    background: var(--pg-surface-raised);
  }

  .example-picker {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .example-picker label {
    color: var(--sl-color-gray-2);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .example-picker select {
    width: auto;
    min-width: 7rem;
    height: 2.35rem;
    border: 1px solid var(--pg-border);
    border-radius: 0.55rem;
    padding: 0 2rem 0 0.7rem;
    color: var(--sl-color-white);
    background-color: var(--sl-color-black);
    font: inherit;
    font-size: 0.88rem;
  }

  .endpoint {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.45rem;
    margin-right: auto;
    color: var(--sl-color-gray-2);
    font-family: var(--__sl-font-mono);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .endpoint span:last-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .endpoint-dot {
    width: 0.5rem;
    height: 0.5rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 0.2rem rgb(34 197 94 / 14%);
  }

  .toolbar-actions,
  .preview-actions,
  .editor-meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .editor-meta {
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.5rem;
  }

  .button,
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    color: inherit;
    font: inherit;
    font-weight: 650;
    cursor: pointer;
    transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;
  }

  .button {
    height: 2.35rem;
    gap: 0.4rem;
    border-radius: 0.55rem;
    padding: 0 0.8rem;
    font-size: 0.84rem;
  }

  .button:hover:not(:disabled),
  .icon-button:hover:not(:disabled) {
    transform: translateY(-1px);
  }

  .button-quiet {
    border-color: var(--pg-border);
    background: var(--sl-color-black);
  }

  .button-quiet:hover {
    border-color: var(--sl-color-gray-3);
    background: var(--sl-color-gray-6);
  }

  .button-primary {
    color: #fff;
    background: #0284c7;
    box-shadow: 0 0.4rem 1.2rem rgb(2 132 199 / 20%);
  }

  .button-primary:hover:not(:disabled) { background: #0369a1; }
  .button:disabled { cursor: wait; opacity: 0.65; }

  .button kbd {
    border: 0;
    border-left: 1px solid rgb(255 255 255 / 24%);
    border-radius: 0;
    margin-left: 0.15rem;
    padding: 0 0 0 0.45rem;
    color: rgb(255 255 255 / 68%);
    background: transparent;
    font-family: inherit;
    font-size: 0.68rem;
  }

  .playground-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: 35rem;
  }

  .pane {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border-top: 0;
    background: var(--pg-surface);
  }

  .editor-pane { border-right: 0; }
  .preview-pane { border-radius: 0 0 0.9rem 0; }
  .editor-pane { border-radius: 0 0 0 0.9rem; }

  .pane-header {
    display: flex;
    min-height: 4.2rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-bottom: 1px solid var(--pg-border);
    padding: 0.75rem 1rem;
    background: var(--pg-surface-raised);
  }

  .pane-header h2 {
    margin: 0.08rem 0 0;
    color: var(--sl-color-white);
    font-size: 0.94rem;
    font-weight: 650;
  }

  .eyebrow {
    color: var(--sl-color-gray-3);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .line-count {
    color: var(--sl-color-gray-3);
    font-family: var(--__sl-font-mono);
    font-size: 0.72rem;
  }

  .lsp-status,
  .problems {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    padding: 0.22rem 0.5rem;
    font-size: 0.68rem;
    font-weight: 650;
    white-space: nowrap;
  }

  .lsp-status {
    color: var(--sl-color-gray-3);
    background: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
  }

  .lsp-status::before {
    content: '';
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: currentColor;
  }

  .lsp-status[data-state='connected'] { color: #7dd3fc; background: rgb(14 165 233 / 13%); }
  .lsp-status[data-state='error'] { color: #fda4af; background: rgb(244 63 94 / 13%); }

  .problems[data-level='ok'] { color: var(--sl-color-gray-2); background: var(--sl-color-gray-6); }
  .problems[data-level='warning'] { color: #fcd34d; background: rgb(245 158 11 / 14%); }
  .problems[data-level='error'] { color: #fda4af; background: rgb(244 63 94 / 14%); }

  .editor-wrap {
    position: relative;
    display: flex;
    min-height: 30rem;
    flex: 1;
    background: var(--sl-color-black);
  }

  .editor-host {
    position: absolute;
    inset: 0;
  }

  .editor-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.9rem;
    color: var(--sl-color-gray-3);
    background: var(--sl-color-black);
    font-size: 0.82rem;
    text-align: center;
  }

  .editor-placeholder .spinner {
    width: 1.6rem;
    height: 1.6rem;
    border-width: 2px;
  }

  [data-editor-ready] .editor-placeholder { display: none; }

  [data-editor-failed] .editor-placeholder {
    color: #fda4af;
    font-weight: 650;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-radius: 999px;
    padding: 0.3rem 0.58rem;
    font-size: 0.69rem;
    font-weight: 700;
  }

  .status::before {
    content: '';
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: currentColor;
  }

  .status-idle { color: var(--sl-color-gray-2); background: var(--sl-color-gray-6); }
  .status-loading { color: #7dd3fc; background: rgb(14 165 233 / 13%); }
  .status-success { color: #86efac; background: rgb(34 197 94 / 13%); }
  .status-error { color: #fda4af; background: rgb(244 63 94 / 13%); }

  .icon-button {
    width: 2.25rem;
    height: 2.25rem;
    border-color: var(--pg-border);
    border-radius: 0.55rem;
    background: var(--sl-color-black);
  }

  .icon-button:disabled { cursor: not-allowed; opacity: 0.38; }

  .preview-stage {
    position: relative;
    display: grid;
    min-height: 30rem;
    flex: 1;
    place-items: center;
    overflow: auto;
    padding: 1.5rem;
    background-color: var(--sl-color-gray-6);
    background-image:
      linear-gradient(45deg, rgb(148 163 184 / 7%) 25%, transparent 25%),
      linear-gradient(-45deg, rgb(148 163 184 / 7%) 25%, transparent 25%),
      linear-gradient(45deg, transparent 75%, rgb(148 163 184 / 7%) 75%),
      linear-gradient(-45deg, transparent 75%, rgb(148 163 184 / 7%) 75%);
    background-position: 0 0, 0 0.6rem, 0.6rem -0.6rem, -0.6rem 0;
    background-size: 1.2rem 1.2rem;
  }

  .preview-stage img {
    display: block;
    max-width: 100%;
    max-height: 30rem;
    border-radius: 0.35rem;
    box-shadow: 0 1.5rem 4rem rgb(2 6 23 / 35%);
    object-fit: contain;
  }

  .preview-stage [hidden],
  .result-meta[hidden] { display: none !important; }

  .empty-state,
  .loading-state,
  .error-state {
    display: flex;
    max-width: 28rem;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .empty-state { gap: 0.45rem; color: var(--sl-color-gray-3); }
  .empty-state strong { margin-top: 0.45rem; color: var(--sl-color-gray-1); font-size: 0.95rem; }
  .empty-state span:last-child { font-size: 0.78rem; }

  .empty-icon {
    display: grid;
    width: 4rem;
    height: 4rem;
    place-items: center;
    border: 1px solid var(--pg-border);
    border-radius: 1.15rem;
    color: #38bdf8;
    background: color-mix(in srgb, var(--sl-color-black) 76%, transparent);
    box-shadow: inset 0 1px rgb(255 255 255 / 4%);
  }

  .loading-state { gap: 0.9rem; color: var(--sl-color-gray-2); font-size: 0.85rem; }

  .spinner {
    width: 2.2rem;
    height: 2.2rem;
    border: 3px solid rgb(56 189 248 / 18%);
    border-top-color: #38bdf8;
    border-radius: 50%;
    animation: spin 700ms linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  .error-state { gap: 0.55rem; }
  .error-state strong { color: #fecdd3; font-size: 1rem; }
  .error-state p { margin: 0; color: var(--sl-color-gray-2); font-family: var(--__sl-font-mono); font-size: 0.75rem; line-height: 1.55; white-space: pre-wrap; }
  .error-code { border-radius: 0.35rem; padding: 0.22rem 0.45rem; color: #fda4af; background: rgb(244 63 94 / 14%); font-family: var(--__sl-font-mono); font-size: 0.66rem; font-weight: 800; }
  .request-id { color: var(--sl-color-gray-3); font-family: var(--__sl-font-mono); font-size: 0.65rem; }

  .result-meta {
    display: flex;
    flex-wrap: wrap;
    min-height: 2.6rem;
    align-items: center;
    gap: 0.35rem 1rem;
    border-top: 1px solid var(--pg-border);
    padding: 0.5rem 1rem;
    color: var(--sl-color-gray-3);
    background: var(--pg-surface-raised);
    font-family: var(--__sl-font-mono);
    font-size: 0.68rem;
  }

  .result-meta span:not(:empty)::before {
    content: '';
    display: inline-block;
    width: 0.28rem;
    height: 0.28rem;
    margin-right: 0.38rem;
    border-radius: 50%;
    vertical-align: 0.08rem;
    background: var(--sl-color-gray-4);
  }

  .result-meta [hidden] { display: none; }

  .playground-note {
    margin: 0.8rem 0 0;
    border-radius: 0.7rem;
    padding: 0.75rem 0.9rem;
    color: var(--sl-color-gray-2);
    background: color-mix(in srgb, var(--sl-color-accent-low) 28%, transparent);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .playground-note a { color: var(--sl-color-accent-high); }

  :global([data-theme='light']) .playground-shell {
    --pg-border: #d8e0e9;
    --pg-surface: #fff;
    --pg-surface-raised: #f8fafc;
  }

  :global([data-theme='light']) .editor-wrap,
  :global([data-theme='light']) .editor-placeholder { background: #fff; }
  :global([data-theme='light']) .preview-stage { background-color: #eef2f7; }
  :global([data-theme='light']) .button-primary { color: #fff; }
  :global([data-theme='light']) .lsp-status[data-state='connected'] { color: #0369a1; background: rgb(3 105 161 / 10%); }
  :global([data-theme='light']) .lsp-status[data-state='error'] { color: #be123c; background: rgb(190 18 60 / 10%); }
